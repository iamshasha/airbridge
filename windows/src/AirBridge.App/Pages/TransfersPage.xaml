<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AirBridge.App.Pages.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:AirBridge.App">

    <Grid Padding="24,8,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Transfers" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Click="OnShareLink" ToolTipService.ToolTip="Send to anyone over the internet with a one-time link">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock Text="Share with a link" />
                    </StackPanel>
                </Button>
                <Button Content="Clear finished" Click="OnClear" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1" x:Name="List" ItemsSource="{x:Bind State.Transfers}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="app:TransferItem">
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind IsActive, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind CanReveal, Mode=OneWay}">
                            <Button Content="Preview" Click="OnPreview" Tag="{x:Bind}" />
                            <Button Content="Show in folder" Click="OnReveal" Tag="{x:Bind}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE8AB;" FontSize="40" Opacity="0.5" />
            <TextBlock Text="No transfers yet" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Drop files on a device, or share a link to send over the internet." Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>
