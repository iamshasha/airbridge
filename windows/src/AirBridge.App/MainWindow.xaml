<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AirBridge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AirBridge">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="AirBridge" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            SelectionChanged="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Devices" Tag="devices" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE701;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TransfersItem" Content="Transfers" Tag="transfers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ActiveBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Received text" Tag="received">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="InboxBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />
                <!-- Confirmation banner: slides in from the top, closes itself. -->
                <InfoBar
                    x:Name="Banner"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    MaxWidth="520"
                    Margin="0,12,0,0"
                    IsOpen="False"
                    IsClosable="True">
                    <InfoBar.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="-24" />
                        </TransitionCollection>
                    </InfoBar.Transitions>
                </InfoBar>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
