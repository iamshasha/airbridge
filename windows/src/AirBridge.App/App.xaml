<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AirBridge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The one brand element: the ring around a device, which is also its transfer progress. -->
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A7AFF" Offset="0" />
                <GradientStop Color="#2ED1F2" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
